generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String                                @id @default(cuid())
  clerkUserId                  String?                               @unique
  email                        String                                @unique
  passwordHash                 String?
  onboardingCompletedAt        DateTime?
  onboardingRole               OnboardingRole?
  createdAt                    DateTime                              @default(now())
  updatedAt                    DateTime                              @updatedAt
  clubs                        Club[]
  fitnessTestTypes             FitnessTestType[]
  invitationsSent              Invitation[]                          @relation("InvitationsSent")
  invitationsAccepted          Invitation[]                          @relation("InvitationsAccepted")
  memberships                  ClubMembership[]
  spectatorAccess              SpectatorAccess[]
  submittedMatchEvents         SubmittedMatchEvent[]                 @relation("SubmittedMatchEvents")
  acceptedSubmittedMatchEvents SubmittedMatchEvent[]                 @relation("AcceptedSubmittedMatchEvents")
  submittedPatternObservations SubmittedTrackingPatternObservation[] @relation("SubmittedPatternObservations")
  reviewedPatternObservations  SubmittedTrackingPatternObservation[] @relation("ReviewedPatternObservations")
  matchTrackingTasksCreated    MatchTrackingTask[]                   @relation("MatchTrackingTasksCreated")
  officialPatternObservations  MatchTrackingPatternObservation[]     @relation("OfficialPatternObservations")
  assignmentsAssigned          MatchContributorAssignment[]          @relation("MatchAssignmentsAssigned")
  assignmentsAssignedBy        MatchContributorAssignment[]          @relation("MatchAssignmentsAssignedBy")
  assignmentRecipients         MatchContributorAssignmentRecipient[]
  notifications                Notification[]
}

enum OnboardingRole {
  CLUB_OFFICIAL
  COACH
  PARENT_SPECTATOR
}

enum ClubRole {
  OWNER
  COACH
  ASSISTANT_COACH
  VIEWER
}

model Club {
  id                      String            @id @default(cuid())
  userId                  String
  name                    String
  location                String?
  notes                   String?
  sendMatchReportEmails   Boolean           @default(true)
  sendFitnessReportEmails Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  invitations             Invitation[]
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams                   Team[]
  memberships             ClubMembership[]
  spectators              SpectatorAccess[]
}

model ClubMembership {
  id              String           @id @default(cuid())
  userId          String
  clubId          String
  role            ClubRole
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  club            Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  teamAssignments TeamAssignment[]

  @@unique([userId, clubId])
}

model TeamAssignment {
  id           String         @id @default(cuid())
  membershipId String
  teamId       String
  createdAt    DateTime       @default(now())
  membership   ClubMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  team         Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([membershipId, teamId])
}

model Team {
  id                  String               @id @default(cuid())
  clubId              String
  name                String
  ageGroup            String
  season              String
  league              String?
  footballPyramidStep String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  club                Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  invitations         Invitation[]
  players             Player[]
  fitnessTestSessions FitnessTestSession[]
  matchDays           MatchDay[]
  assignments         TeamAssignment[]
}

enum InvitationType {
  TEAM_COACH
  TEAM_ASSISTANT
  PLAYER_PARENT
  PLAYER_SPECTATOR
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id              String           @id @default(cuid())
  token           String           @unique
  email           String
  normalizedEmail String
  type            InvitationType
  status          InvitationStatus @default(PENDING)

  clubId   String?
  teamId   String?
  playerId String?

  invitedByUserId  String
  acceptedByUserId String?

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  club       Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team       Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player     Player? @relation(fields: [playerId], references: [id], onDelete: Cascade)
  invitedBy  User    @relation("InvitationsSent", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy User?   @relation("InvitationsAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([normalizedEmail])
  @@index([status])
  @@index([clubId])
  @@index([teamId])
  @@index([playerId])
}

model MatchDay {
  id                   String                                @id @default(cuid())
  teamId               String
  kickoffAt            DateTime
  opposition           String
  matchType            MatchType
  venue                MatchVenue
  ownScore             Int                                   @default(0)
  oppositionScore      Int                                   @default(0)
  status               MatchStatus                           @default(DRAFT)
  firstHalfStartedAt   DateTime?
  firstHalfEndedAt     DateTime?
  secondHalfStartedAt  DateTime?
  secondHalfEndedAt    DateTime?
  completedAt          DateTime?
  createdAt            DateTime                              @default(now())
  updatedAt            DateTime                              @updatedAt
  team                 Team                                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matchDayPlayers      MatchDayPlayer[]
  matchPlayerStints    MatchPlayerStint[]
  matchEvents          MatchEvent[]
  patternObservations  MatchTrackingPatternObservation[]
  matchDayEventTypes   MatchDayEventType[]
  submittedMatchEvents SubmittedMatchEvent[]
  submittedPatterns    SubmittedTrackingPatternObservation[]
  matchTrackingTasks   MatchTrackingTask[]
  notifications        Notification[]
}

model MatchDayEventType {
  id                 String                   @id @default(cuid())
  matchDayId         String
  eventType          MatchEventType?
  category           MatchEventCategory
  eventDefinitionId  String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  matchDay           MatchDay                 @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  eventDefinition    EventDefinition?         @relation(fields: [eventDefinitionId], references: [id], onDelete: SetNull)
  trackingTaskEvents MatchTrackingTaskEvent[]

  @@unique([matchDayId, eventType])
  @@unique([matchDayId, eventDefinitionId])
  @@index([eventDefinitionId])
}

model MatchTrackingTask {
  id              String                  @id @default(cuid())
  matchDayId      String
  createdByUserId String
  topicId         String?
  scopeType       MatchTrackingScope
  playerId        String?
  unitKey         String?
  unitLabel       String?
  title           String
  instructions    String?
  sourceTaskId    String?
  status          MatchTrackingTaskStatus @default(DRAFT)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  matchDay                     MatchDay                              @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  createdBy                    User                                  @relation("MatchTrackingTasksCreated", fields: [createdByUserId], references: [id], onDelete: Cascade)
  topic                        EventTopic?                           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  player                       Player?                               @relation(fields: [playerId], references: [id], onDelete: SetNull)
  sourceTask                   MatchTrackingTask?                    @relation("CopiedMatchTrackingTasks", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  copiedTasks                  MatchTrackingTask[]                   @relation("CopiedMatchTrackingTasks")
  events                       MatchTrackingTaskEvent[]
  patterns                     MatchTrackingTaskPattern[]
  assignments                  MatchContributorAssignment[]
  submittedPatternObservations SubmittedTrackingPatternObservation[]
  officialPatternObservations  MatchTrackingPatternObservation[]

  @@index([matchDayId])
  @@index([createdByUserId])
  @@index([topicId])
  @@index([playerId])
  @@index([sourceTaskId])
  @@index([status])
}

model EventTopic {
  id                 String                    @id @default(cuid())
  ownerScope         EventTopicOwnerScope      @default(GLOBAL)
  clubId             String?
  name               String
  slug               String                    @unique
  normalizedName     String
  description        String?
  phase              TrackingTopicPhase
  focusArea          TrackingFocusArea
  agePhases          EventDefinitionAgePhase[]
  suggestedMaxEvents Int                       @default(6)
  isActive           Boolean                   @default(true)
  archivedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  contexts      EventTopicContext[]
  events        EventTopicEvent[]
  patterns      EventTopicPattern[]
  aliases       EventTopicAlias[]
  trackingTasks MatchTrackingTask[]

  @@unique([ownerScope, clubId, normalizedName])
  @@index([ownerScope])
  @@index([clubId])
  @@index([phase])
  @@index([focusArea])
  @@index([isActive])
}

model EventTopicContext {
  id            String                 @id @default(cuid())
  topicId       String
  scopeType     MatchTrackingScope
  targetContext TrackingTargetContext?
  recommended   Boolean                @default(true)
  displayOrder  Int                    @default(0)
  createdAt     DateTime               @default(now())

  topic EventTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, scopeType, targetContext])
  @@index([scopeType, targetContext])
  @@index([recommended])
}

model EventTopicEvent {
  id                 String   @id @default(cuid())
  topicId            String
  eventDefinitionId  String
  displayOrder       Int
  recommended        Boolean  @default(true)
  guidance           String?
  observerLoadWeight Int      @default(1)
  createdAt          DateTime @default(now())

  topic           EventTopic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  eventDefinition EventDefinition @relation(fields: [eventDefinitionId], references: [id], onDelete: Cascade)

  @@unique([topicId, eventDefinitionId])
  @@index([topicId])
  @@index([eventDefinitionId])
  @@index([recommended])
}

model EventTopicPattern {
  id                 String   @id @default(cuid())
  topicId            String
  patternId          String
  displayOrder       Int
  recommended        Boolean  @default(true)
  guidance           String?
  observerLoadWeight Int      @default(2)
  createdAt          DateTime @default(now())

  topic   EventTopic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  pattern TrackingPatternDefinition @relation(fields: [patternId], references: [id], onDelete: Restrict)

  @@unique([topicId, patternId])
  @@index([topicId])
  @@index([patternId])
  @@index([recommended])
}

model EventTopicAlias {
  id              String   @id @default(cuid())
  topicId         String
  alias           String
  normalizedAlias String
  createdAt       DateTime @default(now())

  topic EventTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, normalizedAlias])
  @@index([normalizedAlias])
}

model MatchTrackingTaskEvent {
  id                  String   @id @default(cuid())
  trackingTaskId      String
  matchDayEventTypeId String
  displayOrder        Int
  createdAt           DateTime @default(now())

  trackingTask      MatchTrackingTask @relation(fields: [trackingTaskId], references: [id], onDelete: Cascade)
  matchDayEventType MatchDayEventType @relation(fields: [matchDayEventTypeId], references: [id], onDelete: Cascade)

  @@unique([trackingTaskId, matchDayEventTypeId])
  @@index([trackingTaskId])
  @@index([matchDayEventTypeId])
}

model MatchTrackingTaskPattern {
  id             String   @id @default(cuid())
  trackingTaskId String
  patternId      String
  displayOrder   Int
  createdAt      DateTime @default(now())

  trackingTask MatchTrackingTask         @relation(fields: [trackingTaskId], references: [id], onDelete: Cascade)
  pattern      TrackingPatternDefinition @relation(fields: [patternId], references: [id], onDelete: Restrict)

  @@unique([trackingTaskId, patternId])
  @@index([trackingTaskId])
  @@index([patternId])
}

model MatchContributorAssignment {
  /// Database invariant: one active assignment per tracking task is enforced by the
  /// partial unique index "MatchContributorAssignment_one_active_per_task" for
  /// PENDING, OFFERED, ACCEPTED and IN_PROGRESS rows. Historical DECLINED,
  /// SUBMITTED and CANCELLED rows are intentionally excluded.
  id               String                           @id @default(cuid())
  trackingTaskId   String
  assignmentMode   MatchContributorAssignmentMode
  status           MatchContributorAssignmentStatus
  assignedUserId   String?
  assignedByUserId String
  acceptedAt       DateTime?
  declinedAt       DateTime?
  startedAt        DateTime?
  submittedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  trackingTask         MatchTrackingTask                     @relation(fields: [trackingTaskId], references: [id], onDelete: Cascade)
  assignedUser         User?                                 @relation("MatchAssignmentsAssigned", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedBy           User                                  @relation("MatchAssignmentsAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Cascade)
  recipients           MatchContributorAssignmentRecipient[]
  submittedMatchEvents SubmittedMatchEvent[]
  submittedPatterns    SubmittedTrackingPatternObservation[]
  officialPatterns     MatchTrackingPatternObservation[]
  notifications        Notification[]

  @@index([trackingTaskId])
  @@index([assignedUserId])
  @@index([assignedByUserId])
  @@index([status])
  @@index([assignmentMode])
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  type         NotificationType
  source       String           @default("SYSTEM")
  title        String
  body         String?
  href         String?
  matchDayId   String?
  assignmentId String?
  dedupeKey    String?
  readAt       DateTime?
  archivedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchDay   MatchDay?                   @relation(fields: [matchDayId], references: [id], onDelete: SetNull)
  assignment MatchContributorAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([assignmentId])
  @@index([matchDayId])
  @@index([type])
  @@index([source])
}

model MatchContributorAssignmentRecipient {
  id           String    @id @default(cuid())
  assignmentId String
  userId       String
  viewedAt     DateTime?
  declinedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())

  assignment MatchContributorAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([assignmentId])
  @@index([userId])
}

model MatchDayPlayer {
  id                  String             @id @default(cuid())
  matchDayId          String
  playerId            String
  squadStatus         MatchSquadStatus   @default(NOT_INVOLVED)
  startingPosition    String?
  shirtNumberSnapshot Int?
  isTracked           Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  matchDay            MatchDay           @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  player              Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  stints              MatchPlayerStint[]

  @@unique([matchDayId, playerId])
}

model MatchPlayerStint {
  id               String         @id @default(cuid())
  matchDayId       String
  matchDayPlayerId String
  playerId         String
  half             MatchHalf
  startedAt        DateTime
  endedAt          DateTime?
  startMatchSecond Int?
  endMatchSecond   Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  matchDay         MatchDay       @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  matchDayPlayer   MatchDayPlayer @relation(fields: [matchDayPlayerId], references: [id], onDelete: Cascade)
  player           Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model MatchEvent {
  id                    String           @id @default(cuid())
  matchDayId            String
  playerId              String?
  eventType             MatchEventType?
  half                  MatchHalf
  matchSecond           Int
  ownScoreAtTime        Int
  oppositionScoreAtTime Int
  x                     Float?
  y                     Float?
  eventDefinitionId     String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  matchDay              MatchDay         @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  player                Player?          @relation(fields: [playerId], references: [id], onDelete: SetNull)
  eventDefinition       EventDefinition? @relation(fields: [eventDefinitionId], references: [id], onDelete: SetNull)

  @@index([eventDefinitionId])
}

model SubmittedMatchEvent {
  id                    String                      @id @default(cuid())
  matchDayId            String
  playerId              String?
  submittedByUserId     String
  eventType             MatchEventType?
  eventDefinitionId     String?
  assignmentId          String?
  half                  MatchHalf
  matchSecond           Int
  ownScoreAtTime        Int
  oppositionScoreAtTime Int
  x                     Float?
  y                     Float?
  note                  String?
  status                SubmittedMatchEventStatus   @default(PENDING)
  acceptedAt            DateTime?
  acceptedByUserId      String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  matchDay              MatchDay                    @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  player                Player?                     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  eventDefinition       EventDefinition?            @relation(fields: [eventDefinitionId], references: [id], onDelete: SetNull)
  assignment            MatchContributorAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  submittedBy           User                        @relation("SubmittedMatchEvents", fields: [submittedByUserId], references: [id], onDelete: Cascade)
  acceptedBy            User?                       @relation("AcceptedSubmittedMatchEvents", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([matchDayId, playerId])
  @@index([eventDefinitionId])
  @@index([assignmentId])
  @@index([submittedByUserId])
  @@index([status])
}

model TrackingPatternDefinition {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  normalizedName   String
  description      String?
  ownerScope       EventTopicOwnerScope @default(GLOBAL)
  clubId           String?
  phase            TrackingTopicPhase
  focusArea        TrackingFocusArea
  active           Boolean              @default(true)
  requiresLocation Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  contexts              TrackingPatternContext[]
  steps                 TrackingPatternStep[]
  outcomes              TrackingPatternOutcome[]
  aliases               TrackingPatternAlias[]
  topicPatterns         EventTopicPattern[]
  taskPatterns          MatchTrackingTaskPattern[]
  submittedObservations SubmittedTrackingPatternObservation[]
  officialObservations  MatchTrackingPatternObservation[]

  @@unique([ownerScope, clubId, normalizedName])
  @@index([ownerScope])
  @@index([clubId])
  @@index([phase])
  @@index([focusArea])
  @@index([active])
}

model TrackingPatternContext {
  id            String                 @id @default(cuid())
  patternId     String
  scopeType     MatchTrackingScope
  targetContext TrackingTargetContext?
  recommended   Boolean                @default(false)
  displayOrder  Int                    @default(0)
  createdAt     DateTime               @default(now())

  pattern TrackingPatternDefinition @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([patternId, scopeType, targetContext])
  @@index([scopeType, targetContext])
  @@index([recommended])
}

model TrackingPatternStep {
  id                String   @id @default(cuid())
  patternId         String
  eventDefinitionId String
  stepOrder         Int
  label             String?
  description       String?
  required          Boolean  @default(true)
  createdAt         DateTime @default(now())

  pattern         TrackingPatternDefinition @relation(fields: [patternId], references: [id], onDelete: Cascade)
  eventDefinition EventDefinition           @relation(fields: [eventDefinitionId], references: [id], onDelete: Restrict)

  @@unique([patternId, stepOrder])
  @@index([patternId])
  @@index([eventDefinitionId])
}

model TrackingPatternOutcome {
  id           String   @id @default(cuid())
  patternId    String
  code         String
  label        String
  description  String?
  displayOrder Int
  positive     Boolean?
  createdAt    DateTime @default(now())

  pattern               TrackingPatternDefinition             @relation(fields: [patternId], references: [id], onDelete: Cascade)
  submittedObservations SubmittedTrackingPatternObservation[]
  officialObservations  MatchTrackingPatternObservation[]

  @@unique([patternId, code])
  @@index([patternId])
}

model TrackingPatternAlias {
  id              String   @id @default(cuid())
  patternId       String
  alias           String
  normalizedAlias String
  createdAt       DateTime @default(now())

  pattern TrackingPatternDefinition @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([patternId, normalizedAlias])
  @@index([normalizedAlias])
}

model SubmittedTrackingPatternObservation {
  id                    String                    @id @default(cuid())
  matchDayId            String
  trackingTaskId        String
  assignmentId          String
  submittedByUserId     String
  playerId              String?
  patternId             String
  outcomeId             String
  half                  MatchHalf
  matchSecond           Int
  ownScoreAtTime        Int
  oppositionScoreAtTime Int
  x                     Float?
  y                     Float?
  note                  String?
  status                SubmittedMatchEventStatus @default(PENDING)
  reviewedAt            DateTime?
  reviewedByUserId      String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  matchDay            MatchDay                         @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  trackingTask        MatchTrackingTask                @relation(fields: [trackingTaskId], references: [id], onDelete: Cascade)
  assignment          MatchContributorAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submittedBy         User                             @relation("SubmittedPatternObservations", fields: [submittedByUserId], references: [id], onDelete: Cascade)
  reviewedBy          User?                            @relation("ReviewedPatternObservations", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  player              Player?                          @relation(fields: [playerId], references: [id], onDelete: SetNull)
  pattern             TrackingPatternDefinition        @relation(fields: [patternId], references: [id], onDelete: Restrict)
  outcome             TrackingPatternOutcome           @relation(fields: [outcomeId], references: [id], onDelete: Restrict)
  officialObservation MatchTrackingPatternObservation?

  @@index([matchDayId])
  @@index([trackingTaskId])
  @@index([assignmentId])
  @@index([submittedByUserId])
  @@index([playerId])
  @@index([patternId])
  @@index([outcomeId])
  @@index([status])
}

model MatchTrackingPatternObservation {
  id                     String    @id @default(cuid())
  submittedObservationId String?   @unique
  matchDayId             String
  trackingTaskId         String
  assignmentId           String?
  submittedByUserId      String?
  playerId               String?
  patternId              String
  outcomeId              String
  half                   MatchHalf
  matchSecond            Int
  ownScoreAtTime         Int
  oppositionScoreAtTime  Int
  x                      Float?
  y                      Float?
  note                   String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  submittedObservation SubmittedTrackingPatternObservation? @relation(fields: [submittedObservationId], references: [id], onDelete: SetNull)
  matchDay             MatchDay                             @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  trackingTask         MatchTrackingTask                    @relation(fields: [trackingTaskId], references: [id], onDelete: Cascade)
  assignment           MatchContributorAssignment?          @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  submittedBy          User?                                @relation("OfficialPatternObservations", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  player               Player?                              @relation(fields: [playerId], references: [id], onDelete: SetNull)
  pattern              TrackingPatternDefinition            @relation(fields: [patternId], references: [id], onDelete: Restrict)
  outcome              TrackingPatternOutcome               @relation(fields: [outcomeId], references: [id], onDelete: Restrict)

  @@index([matchDayId])
  @@index([trackingTaskId])
  @@index([assignmentId])
  @@index([submittedByUserId])
  @@index([playerId])
  @@index([patternId])
  @@index([outcomeId])
}

model EventDefinition {
  id                   String                        @id @default(cuid())
  scope                EventDefinitionScope          @default(GLOBAL)
  clubId               String?
  createdByUserId      String?
  legacyEventType      MatchEventType?               @unique
  name                 String
  slug                 String
  normalizedName       String
  description          String?
  videoUrl             String?
  matchPhase           EventDefinitionMatchPhase
  category             EventDefinitionCategory
  subcategory          String?
  matchDayGroup        EventDefinitionMatchDayGroup?
  agePhases            EventDefinitionAgePhase[]
  fourCorner           EventDefinitionFourCorner
  positionRelevance    EventDefinitionPosition[]
  enabledByDefault     Boolean                       @default(false)
  benchmarkable        Boolean                       @default(false)
  requiresLocation     Boolean                       @default(false)
  isActive             Boolean                       @default(true)
  archivedAt           DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  matchEvents          MatchEvent[]
  matchDayEventTypes   MatchDayEventType[]
  submittedMatchEvents SubmittedMatchEvent[]
  topicEvents          EventTopicEvent[]
  patternSteps         TrackingPatternStep[]

  @@unique([scope, clubId, normalizedName])
  @@unique([scope, clubId, slug])
  @@index([scope])
  @@index([clubId])
  @@index([slug])
  @@index([normalizedName])
  @@index([isActive])
  @@index([scope, isActive])
  @@index([category])
  @@index([subcategory])
  @@index([matchDayGroup])
  @@index([requiresLocation])
  @@index([createdByUserId])
  @@index([enabledByDefault])
