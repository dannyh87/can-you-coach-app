model Player {
  id                   String                                @id @default(cuid())
  teamId               String
  firstName            String
  surname              String
  squadNumber          Int?
  preferredPosition    String?
  dateOfBirth          DateTime?
  joinedClubDate       DateTime?
  isActive             Boolean                               @default(true)
  createdAt            DateTime                              @default(now())
  updatedAt            DateTime                              @updatedAt
  team                 Team                                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fitnessTestResults   FitnessTestResult[]
  invitations          Invitation[]
  matchDayPlayers      MatchDayPlayer[]
  matchPlayerStints    MatchPlayerStint[]
  matchEvents          MatchEvent[]
  spectatorAccess      SpectatorAccess[]
  submittedMatchEvents SubmittedMatchEvent[]
  submittedPatterns    SubmittedTrackingPatternObservation[]
  officialPatterns     MatchTrackingPatternObservation[]
  matchTrackingTasks   MatchTrackingTask[]
}

model SpectatorAccess {
  id        String   @id @default(cuid())
  userId    String
  clubId    String
  playerId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([clubId, playerId, userId])
  @@index([userId])
}

model FitnessTestType {
  id                     String               @id @default(cuid())
  userId                 String?
  name                   String
  description            String?
  setupInstructions      String?
  equipmentNeeded        String?
  scoringNotes           String?
  spaceRequired          String?
  coachNotes             String?
  videoUrl               String?
  targetScores           String?
  resultUnit             String
  higherIsBetter         Boolean
  allowedRecordingModes  String               @default("MANUAL")
  preferredRecordingMode String               @default("MANUAL")
  isDefault              Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  user                   User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fitnessTestSessions    FitnessTestSession[]

  @@unique([userId, name])
}

model FitnessTestSession {
  id                String                   @id @default(cuid())
  teamId            String
  fitnessTestTypeId String
  date              DateTime
  notes             String?
  status            FitnessTestSessionStatus @default(DRAFT)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  team              Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fitnessTestType   FitnessTestType          @relation(fields: [fitnessTestTypeId], references: [id], onDelete: Restrict)
  results           FitnessTestResult[]
}

enum FitnessTestSessionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

model FitnessTestResult {
  id                   String              @id @default(cuid())
  fitnessTestSessionId String
  playerId             String
  resultValue          Float?
  resultText           String?
  status               FitnessResultStatus @default(COMPLETED)
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  fitnessTestSession   FitnessTestSession  @relation(fields: [fitnessTestSessionId], references: [id], onDelete: Cascade)
  player               Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([fitnessTestSessionId, playerId])
}

enum FitnessResultStatus {
  COMPLETED
  DID_NOT_START
  INJURED
  ABSENT
  DROPPED_OUT
}
