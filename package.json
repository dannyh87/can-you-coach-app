{
  "name": "can-you-coach-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:integration": "vitest run src/lib/matchTrackingGroupClaim.integration.test.ts",
    "test:watch": "vitest",
    "lint": "eslint",
    "prestart": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:sync:tactical-events": "node prisma/sync-tactical-event-definitions.mjs",
    "db:sync:tactical-prerequisites": "node prisma/sync-tactical-standard-prerequisites.mjs",
    "db:verify:tactical-presets": "node prisma/verify-tactical-presets.mjs",
    "db:demo": "node --import tsx scripts/demo-data.mjs",
    "db:demo:dry-run": "node --import tsx scripts/demo-data.mjs --dry-run",
    "db:demo:reset": "node --import tsx scripts/demo-data.mjs --reset",
    "db:demo:live": "node --import tsx scripts/demo-data-live.mjs",
    "db:demo:live:dry-run": "node --import tsx scripts/demo-data-live.mjs --dry-run",
    "db:demo:live:cleanup": "node --import tsx scripts/demo-data-live.mjs --cleanup",
    "test:demo": "node --import tsx --test scripts/demo-data.test.mjs",
    "db:demo:verify": "node --import tsx scripts/verify-demo.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.7",
    "@prisma/client": "^6.19.3",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "resend": "^6.17.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^24.1.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
